{
  "name": "@local/dsh-theme-pack",
  "version": "1.2.6",
  "description": "Color theme pack for the DeepSeek Harness web GUI: 19 skins with light and dark palettes, picked from Settings",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "color-scheme",
    "plugin",
    "cordis"
  ],
  "license": "MIT",
  "author": "mrtoxiorg-sys",
  "homepage": "https://github.com/mrtoxiorg-sys/dsh-theme-pack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrtoxiorg-sys/dsh-theme-pack.git"
  },
  "bugs": {
    "url": "https://github.com/mrtoxiorg-sys/dsh-theme-pack/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "REFERENCE.md",
    "install-theme-pack.mjs",
    "verify-theme-pack.mjs",
    "report-token-coverage.mjs",
    "report-token-values.mjs",
    "report-structure.mjs",
    "report-switch.mjs",
    "export-theme-palettes.mjs",
    "make-theme-preview.py",
    "make-token-diagram.py",
    "docs/design-platform.css",
    "docs/shell.css",
    "docs/preview.png",
    "token-coverage.png"
  ]
}
